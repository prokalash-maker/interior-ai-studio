{
  "name": "interior-ai-studio",
  "version": "2.6.0",
  "description": "AI Designer by V1PERCOREJZ — desktop interior visualization studio",
  "author": "V1PERCOREJZ",
  "main": "dist-electron/main.cjs",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build:renderer": "tsc && vite build",
    "build:electron": "node scripts/build-electron.cjs",
    "build": "npm run build:renderer && npm run build:electron",
    "dist": "npm run build && electron-builder --win",
    "dist:dir": "npm run build && electron-builder --win --dir",
    "start": "electron dist-electron/main.cjs",
    "dev:electron": "node scripts/dev-electron.cjs"
  },
  "build": {
    "appId": "com.interiorai.studio",
    "productName": "AI Designer by V1PERCOREJZ",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "AI Designer by V1PERCOREJZ",
      "uninstallDisplayName": "AI Designer by V1PERCOREJZ"
    }
  },
  "dependencies": {
    "lucide-react": "^1.16.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sql.js": "^1.12.0"
  },
  "devDependencies": {
    "@types/node": "^22.13.0",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "@types/sql.js": "^1.4.9",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "electron": "^34.0.2",
    "electron-builder": "^26.18.0",
    "postcss": "^8.5.1",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3",
    "vite": "^6.1.0"
  }
}
